# Base URL used to build absolute canonical and social (Open Graph / Twitter)
# metadata URLs. When unset, the app defaults to http://localhost:3000.

# Local development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production placeholder — set this to the live domain in your host's
# environment variables (for example Vercel Project Settings → Environment Variables).
# NEXT_PUBLIC_SITE_URL=https://frostdew.com

# ---------------------------------------------------------------------------
# Supabase (see supabase/schema.sql)
# ---------------------------------------------------------------------------

# Project URL, for example https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable/anon key. Safe to expose; RLS limits it to SELECT on public tables.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret/service-role key. Server-only. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Admin prototype (see docs/admin.md)
# ---------------------------------------------------------------------------

# Required for the /admin prototype. There is no default password.
ADMIN_PASSWORD=

# Optional HMAC key for the admin session cookie. Falls back to ADMIN_PASSWORD.
ADMIN_SESSION_SECRET=

# Production only: /admin returns 404 unless this is "true".
ADMIN_ENABLED=false

# Production only: admin writes stay disabled unless this is "true".
# Reads and writes now target Supabase; uploaded media still lands on the local
# disk, which is read-only on Vercel.
ADMIN_ALLOW_WRITES=false
