# Base URL used to build absolute canonical and social (Open Graph / Twitter)
# metadata URLs. When unset, the app defaults to http://localhost:3000.

# Local development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production placeholder — set this to the live domain in your host's
# environment variables (for example Vercel Project Settings → Environment Variables).
# NEXT_PUBLIC_SITE_URL=https://frostdew.com

# ---------------------------------------------------------------------------
# Admin prototype (see docs/admin.md)
# ---------------------------------------------------------------------------

# Required for the /admin prototype. There is no default password.
ADMIN_PASSWORD=

# Optional HMAC key for the admin session cookie. Falls back to ADMIN_PASSWORD.
ADMIN_SESSION_SECRET=

# Production only: /admin returns 404 unless this is "true".
ADMIN_ENABLED=false

# Production only: JSON writes stay disabled unless this is "true".
# Vercel's filesystem is read-only, so connect a real backend instead.
ADMIN_ALLOW_WRITES=false
